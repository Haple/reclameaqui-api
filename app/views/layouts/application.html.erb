<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Reclame Aqui API" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Unofficial SerpApi-style API for Reclame Aqui: company reputation, complaints and replies as JSON.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="<%= content_for(:body_class) %>">
    <header class="site-header">
      <a class="brand" href="<%= root_path %>">
        <span class="brand-mark" aria-hidden="true">RA</span>
        <span>Reclame Aqui API</span>
        <span class="pill">unofficial</span>
      </a>
      <nav class="site-nav">
        <%= link_to "Playground", playground_path, class: ("active" if controller_name == "playground") %>
        <%= link_to "Docs", docs_path, class: ("active" if controller_name == "docs") %>
        <%= link_to "Blog", post_path("building-a-reclame-aqui-api"), class: ("active" if controller_name == "posts") %>
        <a href="https://github.com/serpapi/public-roadmap/issues/4590">#4590</a>
        <% if authenticated? %>
          <%= link_to "Admin", admin_path, class: ("active" if controller_name == "admin") if Current.user.admin? %>
          <%= button_to "Sign out", sign_out_path, method: :delete, class: "nav-button", title: "Signed in as #{Current.user.email}" %>
        <% else %>
          <%= link_to "Sign in", sign_in_path, class: ("active" if controller_name.in?(%w[sessions sign_in_links])) %>
        <% end %>
      </nav>
    </header>

    <main><%= yield %></main>
  </body>
</html>
